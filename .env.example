DEVPILOT_ENV=local
DEVPILOT_DATABASE_URL=postgresql+psycopg://devpilot:devpilot@postgres:5432/devpilot
DEVPILOT_REDIS_URL=redis://redis:6379/0
# Fine-grained GitHub token: read-only Actions + Contents (Phase 1)
DEVPILOT_GITHUB_TOKEN=
DEVPILOT_ANTHROPIC_API_KEY=
DEVPILOT_CLAUDE_MODEL=claude-sonnet-5-5
# Phase 2: shared secret for the GitHub webhook (openssl rand -hex 32). Empty disables the endpoint.
DEVPILOT_GITHUB_WEBHOOK_SECRET=
# Host port for the API container (change if 8000 is taken)
# API_PORT=8000

# Phase 3 - AI reliability and cost
# Max LLM tokens per repository per UTC day; over budget falls back to the heuristic. 0 = unlimited.
# DEVPILOT_REPO_DAILY_TOKEN_BUDGET=200000
# Consecutive Claude failures before the circuit breaker opens, and its cooldown in seconds.
# DEVPILOT_LLM_BREAKER_THRESHOLD=5
# DEVPILOT_LLM_BREAKER_COOLDOWN_S=60
# USD per million tokens, used only for the spend estimate on dashboards.
# DEVPILOT_PRICE_INPUT_PER_MTOK=3.0
# DEVPILOT_PRICE_OUTPUT_PER_MTOK=15.0

# Phase 3 - GitHub App for opening PRs on approved fixes (contents:write + pull_requests:write).
# Leave empty to disable POST /api/fixes/{id}/open-pr. The private key may use 
 escapes.
# DEVPILOT_GITHUB_APP_ID=
# DEVPILOT_GITHUB_APP_INSTALLATION_ID=
# DEVPILOT_GITHUB_APP_PRIVATE_KEY=
