# Copy to /opt/devpilot/.env on the VM and chmod 600. Never commit the real file.

# Compose: make plain `docker compose` and scripts target the production file.
COMPOSE_FILE=deploy/vm/docker-compose.prod.yml
# COMPOSE_PROFILES=checks        # enable the sandboxed check worker (mounts the Docker socket)
# DOCKER_GID=999                 # stat -c %g /var/run/docker.sock  (only with the checks profile)

# Registry and image tag (scripts/deploy.sh updates IMAGE_TAG on every deploy)
REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
IMAGE_TAG=latest

# Public hostname (DNS A record -> this VM) and dashboard login.
DEVPILOT_DOMAIN=devpilot.example.com
DEVPILOT_BASIC_USER=admin
# Generate with: ./scripts/make-basic-auth.sh   (single quotes keep the $ characters literal)
DEVPILOT_BASIC_HASH='<paste hash>'

# Secrets
POSTGRES_PASSWORD=change-me-long-random
DEVPILOT_ANTHROPIC_API_KEY=
DEVPILOT_GITHUB_TOKEN=
# Same value you enter in the GitHub webhook settings; generate with: openssl rand -hex 32
DEVPILOT_GITHUB_WEBHOOK_SECRET=

DEVPILOT_CLAUDE_MODEL=claude-sonnet-5-5
# Per-repo daily token budget (0 = unlimited) and the GitHub App used to open PRs for approved fixes
DEVPILOT_REPO_DAILY_TOKEN_BUDGET=200000
DEVPILOT_GITHUB_APP_ID=
DEVPILOT_GITHUB_APP_INSTALLATION_ID=
DEVPILOT_GITHUB_APP_PRIVATE_KEY=

# Backups (scripts/db-backup.sh)
BACKUP_DIR=/var/backups/devpilot
BACKUP_RETAIN_DAYS=14
