# Use the proxy's X-Forwarded-Proto (ALB/ingress/Caddy) when present, else this server's scheme.
map $http_x_forwarded_proto $fwd_proto {
  default $http_x_forwarded_proto;
  "" $scheme;
}

server {
  listen 8080;
  root /usr/share/nginx/html;
  # API_UPSTREAM defaults to the compose service name; on ECS the ALB routes /api/* itself.
  location /api/ {
    proxy_pass http://${API_UPSTREAM};
    proxy_read_timeout 120s;
    # Forward the public host and scheme so the API builds correct OAuth redirect URLs.
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $fwd_proto;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }
  location / { try_files $uri /index.html; }
}
